{
	"name": "hi-words-chouann",
	"version": "1.1.1",
	"description": "Effortlessly grow your vocabulary as you read, with automatic highlighting and translation of unfamiliar words. (Personal fork with customizations)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts \"src/**/*.ts\"",
		"lint:fix": "eslint main.ts \"src/**/*.ts\" --fix",
		"copy-wasm": "node scripts/copy-wasm.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Chouann (fork based on CatMuse/HiWords)",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.8",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"eomi-js": "^0.2.4",
		"lindera-wasm-ko-dic": "^1.0.0",
		"lindera-wasm-ipadic": "^1.2.0"
	}
}
